{
  "name": "jarvis",
  "private": true,
  "version": "0.1.0",
  "description": "Jarvis v3 - personal assistant. See docs/architecture.md.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "core:dev": "npm run dev -w @jarvis/core"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "5.0.2",
    "@types/node": "22.20.4"
  }
}
